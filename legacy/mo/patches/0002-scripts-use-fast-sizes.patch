diff --git a/bin/clean.sh b/bin/clean.sh
index 4eabb96..47d9013 100755
--- a/bin/clean.sh
+++ b/bin/clean.sh
@@ -745,6 +745,11 @@ normalize_paths_for_cleanup() {
 # links outside that root and shared clone blocks stay out of its estimate.
 # This is measurement only; the normal deletion guards still own eligibility.
 _cleanup_path_sizes_kb() {
+    # OpenCleaner patch: the same rule, walked in parallel by the bundled analyzer
+    if [[ -n "${MOLE_FAST_SIZE_BIN:-}" && -x "$MOLE_FAST_SIZE_BIN" ]]; then
+        run_with_timeout "$MOLE_TIMEOUT_DISK_VERIFY_SEC" "$MOLE_FAST_SIZE_BIN" --freed-kb "$@" 2> /dev/null
+        return
+    fi
     # shellcheck disable=SC2016 # The single-quoted program contains Perl variables.
     run_with_timeout "$MOLE_TIMEOUT_DISK_VERIFY_SEC" /usr/bin/perl -e '
         use strict;
diff --git a/lib/core/common.sh b/lib/core/common.sh
index 8763a9c..5141049 100755
--- a/lib/core/common.sh
+++ b/lib/core/common.sh
@@ -12,6 +12,26 @@ readonly MOLE_COMMON_LOADED=1
 
 _MOLE_CORE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 
+# OpenCleaner patch: sizes come from the bundled analyzer's parallel walker. Its build
+# links bin/fastdu/du to analyze-go, which answers `du -sk[cPx]` exactly as /usr/bin/du
+# does and hands any other du command to /usr/bin/du; MOLE_FAST_SIZE_BIN measures what
+# a cleanup frees (clean.sh). It only stands in for the system du: a du someone put
+# first in PATH on purpose (a test stub, GNU coreutils) is left alone, and without that
+# build (plain mo) nothing changes.
+_mole_fastdu_dir="${_MOLE_CORE_DIR%/lib/core}/bin/fastdu"
+if [[ -x "$_mole_fastdu_dir/du" ]]; then
+    case ":$PATH:" in
+        *":$_mole_fastdu_dir:"*) MOLE_FAST_SIZE_BIN="${_MOLE_CORE_DIR%/lib/core}/bin/analyze-go" ;;
+        *)
+            if [[ "$(command -v du 2> /dev/null)" == /usr/bin/du ]]; then
+                export PATH="$_mole_fastdu_dir:$PATH"
+                MOLE_FAST_SIZE_BIN="${_MOLE_CORE_DIR%/lib/core}/bin/analyze-go"
+            fi
+            ;;
+    esac
+fi
+unset _mole_fastdu_dir
+
 # Load core modules
 source "$_MOLE_CORE_DIR/base.sh"
 prepare_mole_tmpdir > /dev/null
