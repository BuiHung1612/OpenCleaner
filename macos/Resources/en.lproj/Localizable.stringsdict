	<key>Delete %lld build folders (%@)? They are rebuilt the next time you build.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Delete %1$#@n@ (%2$@)? They are rebuilt the next time you build.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
