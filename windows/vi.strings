/* Vietnamese for text only the Windows app shows. Everything the Mac app shares comes from
   macos/Resources/vi.lproj/Localizable.strings; this file is read after it. %@ stands for a
   value (a size, a name, a count) and must stay in the translation, in the same order. */

/* pages */
"Asks GitHub for the latest release when OpenCleaner starts. A newer version is installed only if you say yes: it is downloaded, checked against the release's SHA-256, swapped in and OpenCleaner restarts." = "Hỏi GitHub phiên bản mới nhất khi OpenCleaner khởi động. Phiên bản mới chỉ được cài khi bạn đồng ý: tải về, đối chiếu SHA-256 của bản phát hành, thay vào chỗ cũ rồi OpenCleaner khởi động lại.";
"Checked while OpenCleaner is open (at start and every hour). Each alert shows at most once a day." = "Kiểm tra khi OpenCleaner đang mở (lúc khởi động và mỗi giờ). Mỗi cảnh báo hiện tối đa một lần mỗi ngày.";
"Choose a folder OpenCleaner should never scan or clean." = "Chọn thư mục OpenCleaner không bao giờ quét hay dọn.";
"Choose a folder Project Junk should also search." = "Chọn thư mục Project Junk cần tìm thêm.";
"Cleaning now…" = "Đang dọn…";
"Compares contents, not just names" = "So nội dung, không chỉ so tên";
"Could not reach GitHub to check for updates. Check your internet connection and try again." = "Không kết nối được GitHub để kiểm tra cập nhật. Hãy kiểm tra kết nối mạng rồi thử lại.";
"Could not save the excluded folders." = "Không lưu được danh sách thư mục loại trừ.";
"Docker and the Android SDK are not set up on this PC." = "Docker và Android SDK chưa được cài trên máy này.";
"Editors, AI apps and package caches are cleaned in System Junk, under Developer tools." = "Cache của trình soạn thảo, app AI và gói được dọn trong System Junk, mục Developer tools.";
"Everything goes to the Recycle Bin" = "Mọi thứ đều vào Thùng rác";
"Everything in your profile, folder by folder" = "Mọi thứ trong hồ sơ của bạn, từng thư mục";
"Files of 500 MB or more, untouched for 180 days" = "File từ 500 MB trở lên, không mở trong 180 ngày";
"Find big files nobody opened for months, and old screenshots, in your own folders." = "Tìm file lớn đã nhiều tháng không ai mở, và ảnh chụp màn hình cũ, trong các thư mục của bạn.";
"Find identical copies of the same file in Downloads, Documents, Desktop and your media folders." = "Tìm các bản sao giống hệt nhau của cùng một file trong Downloads, Documents, Desktop và các thư mục ảnh, nhạc, video.";
"Give back space held by Docker and the Android SDK, with their own cleanup commands." = "Lấy lại dung lượng Docker và Android SDK đang giữ, bằng chính lệnh dọn dẹp của chúng.";
"Its registry entry is removed; the command is kept in OpenCleaner's history." = "Mục registry của nó bị xóa; lệnh chạy được lưu trong lịch sử của OpenCleaner.";
"Its shortcut goes to the Recycle Bin, so you can put it back." = "Lối tắt của nó vào Thùng rác, nên bạn có thể khôi phục.";
"Light or dark follows the Windows app theme." = "Sáng hay tối theo chủ đề ứng dụng của Windows.";
"Live numbers" = "Số liệu trực tiếp";
"Mapping your files…" = "Đang lập bản đồ file…";
"Never ticked for you. Close the browser first. Removing cookies signs you out of websites." = "Không bao giờ được tick sẵn. Hãy đóng trình duyệt trước. Xóa cookie sẽ đăng xuất bạn khỏi các trang web.";
"No other folders" = "Không có thư mục nào khác";
"Nothing to clean." = "Không có gì để dọn.";
"Nothing yet." = "Chưa có gì.";
"Off (recommended): scans and removals give way to your other apps, so the PC stays smooth. On: they take every CPU core to finish sooner, and other apps may lag or freeze until they are done." = "Tắt (khuyên dùng): quét và xóa nhường cho các app khác, máy vẫn mượt. Bật: dùng mọi nhân CPU để xong nhanh hơn, các app khác có thể giật hoặc đứng cho tới khi xong.";
"Off (recommended): the dashboard reads once when you first open it; press Refresh (or F5) for new numbers, so they may be minutes old. On: numbers are fresh whenever you come back, but every switch back costs a short CPU sample and a redraw (at most once per 10 seconds)." = "Tắt (khuyên dùng): dashboard đọc một lần khi bạn mở lần đầu; bấm Refresh (hoặc F5) để lấy số mới, nên số có thể cũ vài phút. Bật: số luôn mới mỗi khi bạn quay lại, nhưng mỗi lần quay lại tốn một lần đo CPU ngắn và vẽ lại (tối đa một lần mỗi 10 giây).";
"On: live numbers while the dashboard is on screen (paused on other pages and when minimized). Cost: the app keeps working the whole time, which uses CPU and battery and adds a little load to what it measures." = "Bật: số liệu trực tiếp khi dashboard đang hiện (tạm dừng ở trang khác và khi thu nhỏ). Đổi lại: app làm việc liên tục, tốn CPU và pin, và cộng thêm chút tải vào chính số đo.";
"Open OpenCleaner to clean up." = "Mở OpenCleaner để dọn dẹp.";
"Open Startup Apps" = "Mở Startup Apps";
"Open System Junk" = "Mở System Junk";
"OpenCleaner cleaned System Junk: only the items selected by default." = "OpenCleaner đã dọn System Junk: chỉ các mục được chọn sẵn.";
"Project Junk searches your user folder, and these folders too (projects on another drive)." = "Project Junk tìm trong thư mục người dùng, và cả các thư mục này (dự án ở ổ khác).";
"Project folders" = "Thư mục dự án";
"Recycle Bin" = "Thùng rác";
"Runs System Junk while OpenCleaner is open (checked at start and every hour), removing only the items selected by default. The Recycle Bin and browser privacy items are never touched." = "Chạy System Junk khi OpenCleaner đang mở (kiểm tra lúc khởi động và mỗi giờ), chỉ xóa các mục được chọn sẵn. Không bao giờ đụng tới Thùng rác và dữ liệu riêng tư của trình duyệt.";
"Scheduled cleaning" = "Dọn theo lịch";
"Scheduled cleaning failed" = "Dọn theo lịch không thành công";
"Scheduled tasks and services are not listed. Windows Settings shows startup apps too." = "Tác vụ theo lịch và dịch vụ không được liệt kê. Windows Settings cũng hiện các app khởi động.";
"See what takes up space as an interactive map, then send what you don't need to the Recycle Bin." = "Xem cái gì chiếm chỗ trên bản đồ tương tác, rồi đưa những gì không cần vào Thùng rác.";
"Start an app's own uninstaller. Apps that need no installer can also be removed in Settings." = "Chạy trình gỡ cài đặt của chính app. App không cần trình cài đặt cũng có thể gỡ trong Settings.";
"Starts when you sign in" = "Khởi động khi bạn đăng nhập";
"The download did not match the release (SHA-256 differs), so it was not installed." = "File tải về không khớp bản phát hành (SHA-256 khác), nên không được cài.";
"The download failed. Check your internet connection, or that this folder can be written to." = "Tải về thất bại. Hãy kiểm tra kết nối mạng, hoặc quyền ghi vào thư mục này.";
"The excluded folders could not be read." = "Không đọc được danh sách thư mục loại trừ.";
"The extra copies are picked, the first one stays" = "Các bản thừa được chọn, bản đầu tiên được giữ";
"This PC" = "Máy này";
"Time to clean up" = "Đến lúc dọn dẹp";
"Watch the Recycle Bin and Downloads" = "Theo dõi Thùng rác và Downloads";
"What OpenCleaner removed, newest first." = "Những gì OpenCleaner đã xóa, mới nhất trước.";
"What starts when you sign in. Turn off what you do not need; system items are only shown." = "Những gì khởi động khi bạn đăng nhập. Tắt cái bạn không cần; mục hệ thống chỉ được hiển thị.";
"When the app comes to the front" = "Khi app được đưa lên trước";
"Your files, apps and Windows at a glance" = "File, app và Windows của bạn trong một cái nhìn";
"Your user folder" = "Thư mục người dùng";
"OpenCleaner quit unexpectedly last time.\n\nReport it on GitHub? You can review the crash details before posting." = "Lần trước OpenCleaner bị thoát bất ngờ.\n\nBáo lỗi lên GitHub? Bạn có thể xem lại chi tiết trước khi gửi.";
