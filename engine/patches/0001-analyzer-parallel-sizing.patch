+//go:build darwin
+
+package main
+
+import (
+	"context"
+	"errors"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+// The walker must report exactly what `du -skPx -I <name>` reports.
+func duKB(t *testing.T, path string, ignore ...string) int64 {
+	t.Helper()
+	args := []string{"-skPx"}
+	for _, name := range ignore {
+		args = append(args, "-I", name)
+	}
+	out, _ := exec.Command(systemDu, append(args, path)...).Output()
+	kb, err := strconv.ParseInt(strings.Fields(string(out))[0], 10, 64)
+	if err != nil {
+		t.Fatalf("du output %q: %v", out, err)
+	}
+	return kb
+}
+
+func writeSized(t *testing.T, path string, size int) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, make([]byte, size), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestWalkDirectorySizeMatchesDu(t *testing.T) {
+	root := t.TempDir()
+	outside := t.TempDir()
+	for i := range 40 {
+		writeSized(t, filepath.Join(root, "a", strconv.Itoa(i%7), strconv.Itoa(i)+".bin"), 1000+i*3000)
+	}
+	writeSized(t, filepath.Join(root, "big.bin"), 3<<20)
+	// hard links count once
+	if err := os.Link(filepath.Join(root, "big.bin"), filepath.Join(root, "a", "big-link.bin")); err != nil {
+		t.Fatal(err)
+	}
+	// symlinks are not followed
+	writeSized(t, filepath.Join(outside, "huge.bin"), 8<<20)
+	if err := os.Symlink(filepath.Join(outside, "huge.bin"), filepath.Join(root, "link-to-huge")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "link-to-dir")); err != nil {
+		t.Fatal(err)
+	}
+	// ignored names are skipped at any depth
+	writeSized(t, filepath.Join(root, "a", "node_modules", "x.bin"), 2<<20)
+	writeSized(t, filepath.Join(root, "node_modules", "y.bin"), 2<<20)
+
+	for _, ignore := range [][]string{nil, {"node_modules"}} {
+		size, err := walkDirectorySize(context.Background(), root, ignore)
+		if err != nil {
+			t.Fatalf("ignore %v: %v", ignore, err)
+		}
+		if want := duKB(t, root, ignore...); size/1024 != want {
+			t.Errorf("ignore %v: walker %d KB, du %d KB", ignore, size/1024, want)
+		}
+	}
+}
+
+func TestWalkDirectorySizeKeepsPartialSizeOnDenial(t *testing.T) {
+	root := t.TempDir()
+	writeSized(t, filepath.Join(root, "readable.bin"), 1<<20)
+	locked := filepath.Join(root, "locked")
+	writeSized(t, filepath.Join(locked, "secret.bin"), 1<<20)
+	if err := os.Chmod(locked, 0); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(locked, 0o755) })
+
+	size, err := walkDirectorySize(context.Background(), root, nil)
+	if !errors.Is(err, fs.ErrPermission) || !isPermissionFailure(err) {
+		t.Fatalf("err = %v, want a permission failure", err)
+	}
+	if size < 1<<20 || size >= 2<<20 {
+		t.Fatalf("size = %d, want the readable 1 MiB only", size)
+	}
+}
+
+func TestWalkDirectorySizeStopsWhenCanceled(t *testing.T) {
+	root := t.TempDir()
+	writeSized(t, filepath.Join(root, "x", "y.bin"), 4096)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := walkDirectorySize(ctx, root, nil); !errors.Is(err, context.Canceled) {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+}
+
+func TestWalkDirectorySizeOfFileAndMissingPath(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "f.bin")
+	writeSized(t, file, 70000)
+	size, err := walkDirectorySize(context.Background(), file, nil)
+	if err != nil || size/1024 != duKB(t, file) {
+		t.Fatalf("file: %d, %v; du %d KB", size, err, duKB(t, file))
+	}
+	if _, err := walkDirectorySize(context.Background(), file+"-missing", nil); !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("missing: err = %v", err)
+	}
+}
+
+// readDirFast must describe every entry exactly as os.ReadDir + lstat does, for the
+// fields the scanner reads (size, blocks, links, inode, device, mode, owner, times).
+// Directory link counts are not compared: APFS does not return them in bulk and the
+// scanner reads Nlink only for files (hard-link dedupe).
+func TestReadDirFastMatchesLstat(t *testing.T) {
+	root := t.TempDir()
+	writeSized(t, filepath.Join(root, "f.bin"), 123457)
+	writeSized(t, filepath.Join(root, "sub", "g.bin"), 10)
+	if err := os.Link(filepath.Join(root, "f.bin"), filepath.Join(root, "hard")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("f.bin", filepath.Join(root, "sym")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(filepath.Join(root, "sub"), 0o751); err != nil {
+		t.Fatal(err)
+	}
+	// an APFS clone shares all its blocks with f.bin
+	if out, err := exec.Command("/bin/cp", "-c", filepath.Join(root, "f.bin"), filepath.Join(root, "clone.bin")).CombinedOutput(); err != nil {
+		t.Fatalf("cp -c: %v %s", err, out)
+	}
+	sawSharedClone := false
+	dirs := []string{root}
+	for _, d := range strings.Fields(os.Getenv("FASTDIR_EXTRA")) {
+		dirs = append(dirs, d)
+	}
+	for _, dir := range dirs {
+		fast, err := readDirFast(dir)
+		if err != nil {
+			t.Fatalf("%s: %v", dir, err)
+		}
+		slow, err := os.ReadDir(dir)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(fast) != len(slow) {
+			t.Fatalf("%s: %d entries, os.ReadDir has %d", dir, len(fast), len(slow))
+		}
+		for i := range slow {
+			a, b := fast[i], slow[i]
+			if a.Name() != b.Name() || a.IsDir() != b.IsDir() || a.Type() != b.Type() {
+				t.Fatalf("%s: entry %d is %q/%v/%v, want %q/%v/%v", dir, i, a.Name(), a.IsDir(), a.Type(), b.Name(), b.IsDir(), b.Type())
+			}
+			ai, _ := a.Info()
+			bi, err := b.Info()
+			if err != nil {
+				continue // vanished
+			}
+			as, bs := ai.Sys().(*syscall.Stat_t), bi.Sys().(*syscall.Stat_t)
+			path := filepath.Join(dir, a.Name())
+			if ai.Mode() != bi.Mode() || as.Blocks != bs.Blocks || (!ai.IsDir() && as.Nlink != bs.Nlink) || as.Ino != bs.Ino ||
+				as.Dev != bs.Dev || as.Mode != bs.Mode || as.Uid != bs.Uid || as.Gid != bs.Gid || !ai.ModTime().Equal(bi.ModTime()) ||
+				getLastAccessTimeFromInfo(ai) != getLastAccessTimeFromInfo(bi) ||
+				(!ai.IsDir() && ai.Size() != bi.Size()) ||
+				getActualFileSize(path, ai) != getActualFileSize(path, bi) {
+				t.Errorf("%s:\n fast %v mode=%v %+v\n lstat %v mode=%v %+v", path, ai.Size(), ai.Mode(), *as, bi.Size(), bi.Mode(), *bs)
+			}
+			if ai.Mode().IsRegular() && ai.Size() > 0 {
+				fid, fshared, fok := fileCloneIdentity(path, ai)
+				cid, cshared, cok := cloneIdentity(path)
+				if fid != cid || fshared != cshared || fok != cok {
+					t.Errorf("%s: clone identity %d/%v/%v, getattrlist says %d/%v/%v", path, fid, fshared, fok, cid, cshared, cok)
+				}
+				sawSharedClone = sawSharedClone || (dir == root && a.Name() == "clone.bin" && fshared)
+			}
+		}
+	}
+	if !sawSharedClone {
+		t.Error("clone.bin was not reported as sharing all its blocks")
+	}
+}
