+// --freed-kb must agree with clean.sh's Perl rule: regular files at private size,
+// hard links only when every link is inside, clones not counted twice.
+func TestFreedKBMatchesCleanPerlRule(t *testing.T) {
+	root := t.TempDir()
+	writeSized(t, filepath.Join(root, "d", "plain"), 200000)
+	writeSized(t, filepath.Join(root, "d", "shared"), 300000)
+	writeSized(t, filepath.Join(root, "outside"), 400000)
+	// one link inside d and one outside: deleting d frees nothing for it
+	if err := os.Link(filepath.Join(root, "outside"), filepath.Join(root, "d", "half-link")); err != nil {
+		t.Fatal(err)
+	}
+	// both links inside d: counted once
+	if err := os.Link(filepath.Join(root, "d", "shared"), filepath.Join(root, "d", "shared-link")); err != nil {
+		t.Fatal(err)
+	}
+	// an APFS clone of a file outside d shares its blocks: frees (almost) nothing
+	writeSized(t, filepath.Join(root, "orig"), 1<<20)
+	if out, err := exec.Command("/bin/cp", "-c", filepath.Join(root, "orig"), filepath.Join(root, "d", "clone")).CombinedOutput(); err != nil {
+		t.Fatalf("cp -c: %v %s", err, out)
+	}
+	if err := os.Symlink(filepath.Join(root, "orig"), filepath.Join(root, "d", "sym")); err != nil {
+		t.Fatal(err)
+	}
+
+	perl := cleanPerlSizer(t)
+	for _, p := range []string{filepath.Join(root, "d"), filepath.Join(root, "d", "plain"), filepath.Join(root, "d", "sym"), filepath.Join(root, "missing"), root} {
+		size, _ := measureTree(t.Context(), p, treeOptions{private: true}, nil)
+		want, err := exec.Command("/usr/bin/perl", "-e", perl, p).Output()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := strconv.FormatInt(kbCeil(size), 10) + "\n"; got != string(want) {
+			t.Errorf("%s: --freed-kb %q, perl %q", p, got, want)
+		}
+	}
+}
+
+// cleanPerlSizer is the Perl program clean.sh used before this patch (verbatim).
+func cleanPerlSizer(t *testing.T) string {
+	t.Helper()
+	return `
+        use strict;
+        use warnings;
+        use File::Find;
+        use Fcntl qw(:mode);
+        sub private_bytes {
+            my ($path, $allocated) = @_;
+            my $attrs = pack("SSLLLLL", 5, 0, 0x80040000, 0, 0, 0, 8);
+            my $reply = "\0" x 36;
+            my $name = "$path\0";
+            return $allocated if syscall(220, $name, $attrs, $reply, 36, 0x21) != 0;
+            my ($length, $common, $volume, $dir, $file, $extended, $flags, $private) = unpack("L7Q", $reply);
+            return $allocated if $length < 36 || !($common & 0x40000) || !($extended & 8) || ($flags & 0x20);
+            return $private < $allocated ? $private : $allocated;
+        }
+        for my $root (@ARGV) {
+            my @root_stat = lstat($root);
+            if (!@root_stat || S_ISLNK($root_stat[2])) { print "0\n" or die $!; next; }
+            my %links;
+            my $bytes = 0;
+            my $visit = sub {
+                my $path = $_;
+                my @s = lstat($path);
+                return unless @s;
+                if ($s[0] != $root_stat[0]) { $File::Find::prune = 1; return; }
+                return unless S_ISREG($s[2]);
+                my $allocated = $s[12] * 512;
+                my $size = private_bytes($path, $allocated);
+                if ($s[3] > 1) {
+                    my $key = "$s[0]:$s[1]";
+                    $links{$key} ||= [0, $s[3], $size];
+                    $links{$key}[0]++;
+                } else { $bytes += $size; }
+            };
+            if (S_ISDIR($root_stat[2])) {
+                find({wanted => $visit, no_chdir => 1, follow => 0}, $root);
+            } else { local $_ = $root; $visit->(); }
+            for my $link (values %links) {
+                $bytes += $link->[2] if $link->[0] == $link->[1];
+            }
+            print(int(($bytes + 1023) / 1024), "\n") or die $!;
+        }`
+}
