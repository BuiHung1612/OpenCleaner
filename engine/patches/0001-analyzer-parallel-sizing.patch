diff --git a/cmd/analyze/sizecli.go b/cmd/analyze/sizecli.go
new file mode 100644
index 0000000..7be2d2b
--- /dev/null
+++ b/cmd/analyze/sizecli.go
@@ -0,0 +1,112 @@
+//go:build darwin
+
+package main
+
+// OpenCleaner patch: command-line front ends for the parallel tree walker (fastsize.go),
+// so mo's shell scripts get fast sizes without changing how they ask for them.
+//
+//   - Run as `du` (bin/fastdu/du links here and comes first in mo's PATH), it answers
+//     `du -s -k [-c] [-P] [-x] [--] path...` exactly like /usr/bin/du: one "<KB>\t<path>"
+//     line per operand, a "<KB>\ttotal" line for -c, hard links counted once per run,
+//     status 1 with a "du: path: error" line when something could not be read. Any other
+//     flag hands the whole command to /usr/bin/du.
+//   - `analyze-go --freed-kb path...` prints, per path, the KB clean.sh counts as freed
+//     (see treeOptions.private); it replaces the Perl walk in clean.sh.
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+)
+
+const systemDuPath = "/usr/bin/du"
+
+// sizeCLI dispatches the size front ends; ok is false for a regular analyze run.
+func sizeCLI(argv []string) (code int, ok bool) {
+	if filepath.Base(argv[0]) == "du" {
+		return runDuCompat(argv[1:]), true
+	}
+	if len(argv) > 1 && argv[1] == "--freed-kb" {
+		return runFreedKB(argv[2:]), true
+	}
+	return 0, false
+}
+
+func kbCeil(bytes int64) int64 { return (bytes + 1023) / 1024 }
+
+func runDuCompat(args []string) int {
+	var summary, kilo, total, oneFS bool
+	operands := args
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		if a == "--" {
+			operands = args[i+1:]
+			break
+		}
+		if !strings.HasPrefix(a, "-") || a == "-" {
+			operands = args[i:]
+			break
+		}
+		for _, c := range a[1:] {
+			switch c {
+			case 's':
+				summary = true
+			case 'k':
+				kilo = true
+			case 'c':
+				total = true
+			case 'x':
+				oneFS = true
+			case 'P':
+			default:
+				return execSystemDu(args)
+			}
+		}
+		operands = nil
+	}
+	if !summary || !kilo || len(operands) == 0 {
+		return execSystemDu(args)
+	}
+
+	links := &sync.Map{}
+	opts := treeOptions{crossMounts: !oneFS, missingIsError: true}
+	status := 0
+	var sum int64
+	for _, path := range operands {
+		size, err := measureTree(context.Background(), path, opts, links)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "du: %s: %v\n", path, err)
+			status = 1
+			if size == 0 {
+				if _, statErr := os.Lstat(path); statErr != nil {
+					continue // du prints no line for an operand it cannot stat
+				}
+			}
+		}
+		sum += size
+		fmt.Printf("%d\t%s\n", kbCeil(size), path)
+	}
+	if total {
+		fmt.Printf("%d\ttotal\n", kbCeil(sum))
+	}
+	return status
+}
+
+func execSystemDu(args []string) int {
+	err := syscall.Exec(systemDuPath, append([]string{"du"}, args...), os.Environ())
+	fmt.Fprintf(os.Stderr, "du: %v\n", err)
+	return 1
+}
+
+// runFreedKB matches clean.sh's former Perl sizer: one line per path, errors ignored.
+func runFreedKB(paths []string) int {
+	for _, path := range paths {
+		size, _ := measureTree(context.Background(), path, treeOptions{private: true}, &sync.Map{})
+		fmt.Printf("%d\n", kbCeil(size))
+	}
+	return 0
+}
diff --git a/cmd/analyze/sizecli_test.go b/cmd/analyze/sizecli_test.go
new file mode 100644
index 0000000..6b1918d
--- /dev/null
+++ b/cmd/analyze/sizecli_test.go
@@ -0,0 +1,188 @@
+//go:build darwin
+
+package main
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+// runAs runs this test binary's du front end in a child process, as `du args...`.
+func runFastDu(t *testing.T, args ...string) (string, int) {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], append([]string{"-test.run=TestHelperFastDu", "--"}, args...)...)
+	cmd.Env = append(os.Environ(), "FASTDU_HELPER=1")
+	var out bytes.Buffer
+	cmd.Stdout = &out
+	err := cmd.Run()
+	code := 0
+	if exitErr, ok := err.(*exec.ExitError); ok {
+		code = exitErr.ExitCode()
+	} else if err != nil {
+		t.Fatal(err)
+	}
+	return out.String(), code
+}
+
+func TestHelperFastDu(t *testing.T) {
+	if os.Getenv("FASTDU_HELPER") != "1" {
+		t.Skip()
+	}
+	args := os.Args
+	for i, a := range args {
+		if a == "--" {
+			args = args[i+1:]
+			break
+		}
+	}
+	os.Exit(runDuCompat(args))
+}
+
+func runSystemDu(args ...string) (string, int) {
+	cmd := exec.Command(systemDuPath, args...)
+	var out bytes.Buffer
+	cmd.Stdout = &out
+	err := cmd.Run()
+	if exitErr, ok := err.(*exec.ExitError); ok {
+		return out.String(), exitErr.ExitCode()
+	}
+	return out.String(), 0
+}
+
+// Every flag combination mo's scripts use must print what /usr/bin/du prints.
+func TestDuCompatMatchesSystemDu(t *testing.T) {
+	root := t.TempDir()
+	for i := range 30 {
+		writeSized(t, filepath.Join(root, "a", strconv.Itoa(i%4), strconv.Itoa(i)), 700+i*4099)
+	}
+	writeSized(t, filepath.Join(root, "b", "big"), 3<<20)
+	// a hard link shared by two operands counts once per du run
+	if err := os.Link(filepath.Join(root, "b", "big"), filepath.Join(root, "a", "big-link")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(root, "b"), filepath.Join(root, "link-to-b")); err != nil {
+		t.Fatal(err)
+	}
+	a, b, file, link := filepath.Join(root, "a"), filepath.Join(root, "b"), filepath.Join(root, "b", "big"), filepath.Join(root, "link-to-b")
+	missing := filepath.Join(root, "missing")
+
+	for _, args := range [][]string{
+		{"-skP", root},
+		{"-skP", a},
+		{"-skPx", root},
+		{"-sk", a, b},
+		{"-skcP", a, b},
+		{"-skcP", a, missing, b},
+		{"-skP", missing},
+		{"-skP", file},
+		{"-skP", link},
+		{"-s", "-k", "-P", "--", a},
+	} {
+		got, gotCode := runFastDu(t, args...)
+		want, wantCode := runSystemDu(args...)
+		if got != want || gotCode != wantCode {
+			t.Errorf("du %v:\n got  %q (status %d)\n want %q (status %d)", args, got, gotCode, want, wantCode)
+		}
+	}
+}
