+//go:build darwin
+
+package main
+
+// OpenCleaner patch: faster directory reading for the analyzer.
+//
+//   - readDirBulk lists a directory with getattrlistbulk(2): one system call returns
+//     name, type, size, link count and times for many entries, where os.ReadDir plus
+//     DirEntry.Info costs a readdir and then one lstat per entry.
+//   - walkDirectorySize replaces `du -skPx -I <name>...`. du walks one directory at a
+//     time; on a large ~/Library it needed 30–80 s and the overview gave up at its
+//     30 s deadline with a partial size. This walker reads many directories at once
+//     and returns the same number: allocated blocks, symlinks not followed, mount
+//     points not crossed, hard-linked files counted once per walk.
+//   - readDirFast is os.ReadDir with Info() already filled in from the same call.
+//
+// File systems without getattrlistbulk (SMB, FAT…) fall back to readdir + lstat.
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"runtime"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// ---- getattrlistbulk ----
+
+// Attributes asked of getattrlistbulk(2). The kernel packs returned ones in bit order,
+// with ATTR_CMN_RETURNED_ATTRS first and ATTR_CMN_ERROR right after it.
+const (
+	bulkCommon = unix.ATTR_CMN_RETURNED_ATTRS | attrCmnError | unix.ATTR_CMN_NAME | unix.ATTR_CMN_DEVID |
+		unix.ATTR_CMN_OBJTYPE | unix.ATTR_CMN_MODTIME | unix.ATTR_CMN_ACCTIME | unix.ATTR_CMN_OWNERID | unix.ATTR_CMN_GRPID | unix.ATTR_CMN_ACCESSMASK | unix.ATTR_CMN_FLAGS | unix.ATTR_CMN_FILEID
+	bulkDir  = attrDirLinkCount | attrDirMountStatus | attrDirAllocSize
+	bulkFile = unix.ATTR_FILE_LINKCOUNT | unix.ATTR_FILE_ALLOCSIZE | unix.ATTR_FILE_DATALENGTH
+	// with FSOPT_ATTR_CMN_EXTENDED the fork group carries extended common attributes,
+	// packed last: the private size clean.sh counts as freed, and the APFS clone id and
+	// flags countableFileSize needs (clone_darwin.go)
+	bulkFork = attrCmnextPrivateSize | attrCmnextCloneID | attrCmnextExtFlags
+
+	attrCmnextPrivateSize = 0x8
+	ufCompressed          = 0x20 // UF_COMPRESSED in st_flags
+
+	attrCmnError       = 0x20000000 // <sys/attr.h>; not in x/sys
+	attrDirLinkCount   = 0x1
+	attrDirMountStatus = 0x4
+	attrDirAllocSize   = 0x8
+	dirMntStatusMntPt  = 0x1
+)
+
+// enum vtype in <sys/vnode.h>
+const (
+	vReg  = 1
+	vDir  = 2
+	vBlk  = 3
+	vChr  = 4
+	vLnk  = 5
+	vSock = 6
+	vFifo = 7
+)
+
+// bulkStat is one directory entry as getattrlistbulk reports it.
+type bulkStat struct {
+	name       string
+	objType    uint32
+	dev        int32
+	ino        uint64
+	perm       uint32
+	flags      uint32 // st_flags
+	uid, gid   uint32
+	nlink      uint32
+	alloc      int64 // allocated bytes (st_blocks * 512)
+	size       int64 // logical length
+	atime      unix.Timespec
+	mtime      unix.Timespec
+	mountPoint bool
+	cloneKnown bool
+	cloneID    uint64
+	extFlags   uint64
+	// bytes only this file holds (shared clone blocks excluded), when the volume knows
+	private      int64
+	privateKnown bool
+	err          syscall.Errno // the entry could not be read
+}
+
+var bulkBuffers = sync.Pool{New: func() any { b := make([]byte, 128<<10); return &b }}
+
+// errBulkUnsupported means the file system has no getattrlistbulk; nothing was read.
+var errBulkUnsupported = errors.New("getattrlistbulk not supported")
+
+// readDirBulk calls fn for every entry of the open directory f. It returns
+// errBulkUnsupported, before calling fn, when the file system lacks the call.
+func readDirBulk(f *os.File, fn func(*bulkStat)) error {
+	attrs := unix.Attrlist{Bitmapcount: unix.ATTR_BIT_MAP_COUNT, Commonattr: bulkCommon, Dirattr: bulkDir, Fileattr: bulkFile, Forkattr: bulkFork}
+	bufp := bulkBuffers.Get().(*[]byte)
+	defer bulkBuffers.Put(bufp)
+	buf := *bufp
+	first := true
+	var st bulkStat
+	for {
+		n, _, errno := unix.Syscall6(unix.SYS_GETATTRLISTBULK, f.Fd(), uintptr(unsafe.Pointer(&attrs)),
+			uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)), unix.FSOPT_ATTR_CMN_EXTENDED, 0)
+		if errno == unix.EINTR {
+			continue
+		}
+		if errno != 0 {
+			if first && (errno == unix.ENOTSUP || errno == unix.EINVAL || errno == unix.ENOSYS) {
+				return errBulkUnsupported
+			}
+			return &os.PathError{Op: "getattrlistbulk", Path: f.Name(), Err: errno}
+		}
+		first = false
+		if n == 0 {
+			return nil
+		}
+		off := 0
+		for range int(n) {
+			if off+4 > len(buf) {
+				return fmt.Errorf("getattrlistbulk %s: short buffer", f.Name())
+			}
+			entryLen := int(binary.LittleEndian.Uint32(buf[off:]))
+			if entryLen < 4 || off+entryLen > len(buf) {
+				return fmt.Errorf("getattrlistbulk %s: bad entry length %d", f.Name(), entryLen)
+			}
+			if parseBulkEntry(buf[off:off+entryLen], &st) {
+				fn(&st)
+			}
+			off += entryLen
+		}
+	}
+}
+
+// parseBulkEntry decodes one packed entry, reading only the attributes the kernel
+// says it returned. It reports false for an entry it cannot make sense of.
+func parseBulkEntry(e []byte, st *bulkStat) bool {
+	*st = bulkStat{nlink: 1}
+	r := e[4:]
+	ok := true
+	need := func(n int) bool {
+		if len(r) < n {
+			ok = false
+		}
+		return ok
+	}
+	u32 := func() uint32 {
+		if !need(4) {
+			return 0
+		}
+		v := binary.LittleEndian.Uint32(r)
+		r = r[4:]
+		return v
+	}
+	u64 := func() uint64 {
+		if !need(8) {
+			return 0
+		}
+		v := binary.LittleEndian.Uint64(r)
+		r = r[8:]
+		return v
+	}
+	ts := func() unix.Timespec { return unix.Timespec{Sec: int64(u64()), Nsec: int64(u64())} }
+
+	cmn, _, dirAttrs, fileAttrs, extAttrs := u32(), u32(), u32(), u32(), u32()
+	if cmn&attrCmnError != 0 {
+		st.err = syscall.Errno(u32())
+	}
+	if cmn&unix.ATTR_CMN_NAME != 0 && need(8) {
+		field := len(e) - len(r)
+		start := field + int(int32(binary.LittleEndian.Uint32(r)))
+		length := int(binary.LittleEndian.Uint32(r[4:]))
+		r = r[8:]
+		if length > 1 && start >= 0 && start+length <= len(e) {
+			st.name = strings.Clone(string(e[start : start+length-1])) // drop the NUL
+		}
+	}
+	if st.err != 0 {
+		return ok && st.name != ""
+	}
+	if cmn&unix.ATTR_CMN_DEVID != 0 {
+		st.dev = int32(u32())
+	}
+	if cmn&unix.ATTR_CMN_OBJTYPE != 0 {
+		st.objType = u32()
+	}
+	if cmn&unix.ATTR_CMN_MODTIME != 0 {
+		st.mtime = ts()
+	}
+	if cmn&unix.ATTR_CMN_ACCTIME != 0 {
+		st.atime = ts()
+	}
+	if cmn&unix.ATTR_CMN_OWNERID != 0 {
+		st.uid = u32()
+	}
+	if cmn&unix.ATTR_CMN_GRPID != 0 {
+		st.gid = u32()
+	}
+	if cmn&unix.ATTR_CMN_ACCESSMASK != 0 {
+		st.perm = u32()
+	}
+	if cmn&unix.ATTR_CMN_FLAGS != 0 {
+		st.flags = u32()
+	}
+	if cmn&unix.ATTR_CMN_FILEID != 0 {
+		st.ino = u64()
+	}
+	if st.objType == vDir {
+		if dirAttrs&attrDirLinkCount != 0 {
+			st.nlink = u32()
+		}
+		if dirAttrs&attrDirMountStatus != 0 {
+			st.mountPoint = u32()&dirMntStatusMntPt != 0
+		}
+		if dirAttrs&attrDirAllocSize != 0 {
+			st.alloc = int64(u64())
+		}
+	} else {
+		if fileAttrs&unix.ATTR_FILE_LINKCOUNT != 0 {
+			st.nlink = u32()
+		}
+		if fileAttrs&unix.ATTR_FILE_ALLOCSIZE != 0 {
+			st.alloc = int64(u64())
+		}
+		if fileAttrs&unix.ATTR_FILE_DATALENGTH != 0 {
+			st.size = int64(u64())
+		}
+	}
+	if extAttrs&attrCmnextPrivateSize != 0 {
+		st.private, st.privateKnown = int64(u64()), true
+	}
+	if extAttrs&attrCmnextCloneID != 0 {
+		st.cloneID = u64()
+	}
+	if extAttrs&attrCmnextExtFlags != 0 {
+		st.extFlags = u64()
+	}
+	st.cloneKnown = extAttrs&attrCmnextCloneID != 0 && extAttrs&attrCmnextExtFlags != 0
+	return ok && st.name != ""
+}
+
+// ---- readDirFast: os.ReadDir with Info() included ----
+
+type bulkDirEntry struct {
+	info *bulkFileInfo
+}
+
+func (d bulkDirEntry) Name() string               { return d.info.name }
+func (d bulkDirEntry) IsDir() bool                { return d.info.IsDir() }
+func (d bulkDirEntry) Type() fs.FileMode          { return d.info.Mode().Type() }
+func (d bulkDirEntry) Info() (fs.FileInfo, error) { return d.info, nil }
+
+type bulkFileInfo struct {
+	name       string
+	mode       fs.FileMode
+	stat       syscall.Stat_t
+	cloneKnown bool
+	cloneID    uint64
+	sharesAll  bool
+}
+
+// fileCloneIdentity is cloneIdentity, answered from the bulk listing when the
+// entry came from readDirFast (no extra getattrlist per file).
+func fileCloneIdentity(path string, info fs.FileInfo) (cloneID uint64, sharesAll bool, ok bool) {
+	if b, isBulk := info.(*bulkFileInfo); isBulk && b.cloneKnown {
+		return b.cloneID, b.sharesAll, true
+	}
+	return cloneIdentity(path)
+}
+
+func (i *bulkFileInfo) Name() string      { return i.name }
+func (i *bulkFileInfo) Size() int64       { return i.stat.Size }
+func (i *bulkFileInfo) Mode() fs.FileMode { return i.mode }
+func (i *bulkFileInfo) ModTime() time.Time {
+	return time.Unix(i.stat.Mtimespec.Sec, i.stat.Mtimespec.Nsec)
+}
+func (i *bulkFileInfo) IsDir() bool { return i.mode.IsDir() }
+func (i *bulkFileInfo) Sys() any    { return &i.stat }
+
+func (st *bulkStat) fileInfo() *bulkFileInfo {
+	mode := fs.FileMode(st.perm & 0o777)
+	ifmt := uint16(0)
+	switch st.objType {
+	case vDir:
+		mode |= fs.ModeDir
+		ifmt = syscall.S_IFDIR
+	case vLnk:
+		mode |= fs.ModeSymlink
+		ifmt = syscall.S_IFLNK
+	case vBlk:
+		mode |= fs.ModeDevice
+		ifmt = syscall.S_IFBLK
+	case vChr:
+		mode |= fs.ModeDevice | fs.ModeCharDevice
+		ifmt = syscall.S_IFCHR
+	case vSock:
+		mode |= fs.ModeSocket
+		ifmt = syscall.S_IFSOCK
+	case vFifo:
+		mode |= fs.ModeNamedPipe
+		ifmt = syscall.S_IFIFO
+	default:
+		ifmt = syscall.S_IFREG
+	}
+	if st.perm&syscall.S_ISUID != 0 {
+		mode |= fs.ModeSetuid
+	}
+	if st.perm&syscall.S_ISGID != 0 {
+		mode |= fs.ModeSetgid
+	}
+	if st.perm&syscall.S_ISVTX != 0 {
+		mode |= fs.ModeSticky
+	}
+	return &bulkFileInfo{name: st.name, mode: mode, cloneKnown: st.cloneKnown, cloneID: st.cloneID, sharesAll: st.extFlags&efSharesAllBlocks != 0, stat: syscall.Stat_t{
+		Dev:       st.dev,
+		Ino:       st.ino,
+		Mode:      ifmt | uint16(st.perm&0o7777),
+		Uid:       st.uid,
+		Gid:       st.gid,
+		Nlink:     uint16(min(st.nlink, 0xFFFF)),
+		Size:      st.size,
+		Blocks:    (st.alloc + 511) / 512,
+		Atimespec: syscall.Timespec{Sec: st.atime.Sec, Nsec: st.atime.Nsec},
+		Mtimespec: syscall.Timespec{Sec: st.mtime.Sec, Nsec: st.mtime.Nsec},
+	}}
+}
+
+// For a directory, Size() is 0 and Nlink may be 1 (APFS does not return its link
+// count in bulk); the scanner reads neither for directories.
+
+// readDirFast behaves like os.ReadDir (entries sorted by name) but each entry's
+// Info() needs no further system call. A mount point gets a real lstat, because
+// getattrlistbulk describes the directory underneath it, not the mounted volume.
+func readDirFast(path string) ([]fs.DirEntry, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+
+	var entries []fs.DirEntry
+	var firstErr error
+	err = readDirBulk(f, func(st *bulkStat) {
+		if st.err != 0 || st.mountPoint {
+			// unreadable entry or mount point: let the regular lstat path describe it
+			info, lerr := os.Lstat(path + "/" + st.name)
+			if lerr != nil {
+				if firstErr == nil && !errors.Is(lerr, fs.ErrNotExist) {
+					firstErr = lerr
+				}
+				return
+			}
+			entries = append(entries, fs.FileInfoToDirEntry(info))
+			return
+		}
+		entries = append(entries, bulkDirEntry{st.fileInfo()})
+	})
+	if errors.Is(err, errBulkUnsupported) {
+		return os.ReadDir(path)
+	}
+	slices.SortFunc(entries, func(a, b fs.DirEntry) int { return strings.Compare(a.Name(), b.Name()) })
+	if err == nil {
+		err = firstErr
+	}
+	return entries, err
+}
+
+// ---- tree sizes: du -skP[x] and clean.sh's freed-bytes rule ----
+
+type treeOptions struct {
+	ignore      map[string]bool
+	crossMounts bool // descend into other file systems (du without -x)
+	// private applies clean.sh's rule for what deleting the tree frees: regular files
+	// only, each at its private size (blocks shared with APFS clones excluded) unless
+	// compressed, and a hard-linked file only when all of its links are inside the tree.
+	private bool
+	// missingIsError reports entries that vanish mid-walk as failures, as du does;
+	// the analyzer ignores them (a file deleted while we walk does not make a size wrong).
+	missingIsError bool
+}
+
+type walkInode struct {
+	dev int32
+	ino uint64
+}
+
+type privateLink struct {
+	seen, nlink uint32
+	size        int64
+}
+
+type treeWalk struct {
+	ctx     context.Context
+	opts    treeOptions
+	dev     int32 // the root's file system
+	total   atomic.Int64
+	links   *sync.Map // walkInode -> struct{}; du counts a hard link once per invocation
+	mu      sync.Mutex
+	cond    *sync.Cond
+	queue   []string
+	pending int // directories queued or being read
+
+	privMu    sync.Mutex
+	privLinks map[walkInode]*privateLink
+
+	errMu    sync.Mutex
+	firstErr error
+	allPerm  bool
+}
+
+// walkDirectorySize returns what `du -skPx -I <name>...` measures for path, in bytes.
+// Like du, it keeps what it could measure when part of the tree is unreadable or the
+// context ends, and reports that with an error (wrapping fs.ErrPermission when every
+// failure was a permission denial).
+func walkDirectorySize(ctx context.Context, path string, ignoreNames []string) (int64, error) {
+	opts := treeOptions{ignore: make(map[string]bool, len(ignoreNames))}
+	for _, name := range ignoreNames {
+		opts.ignore[name] = true
+	}
+	return measureTree(ctx, path, opts, &sync.Map{})
+}
+
+// measureTree sizes one tree. links is shared between calls that must count a hard
+// link once (the operands of one du invocation).
+func measureTree(ctx context.Context, path string, opts treeOptions, links *sync.Map) (int64, error) {
+	var root syscall.Stat_t
+	if err := syscall.Lstat(path, &root); err != nil {
+		return 0, &os.PathError{Op: "lstat", Path: path, Err: err}
+	}
+	w := &treeWalk{ctx: ctx, opts: opts, dev: root.Dev, links: links, allPerm: true, privLinks: map[walkInode]*privateLink{}}
+	switch root.Mode & syscall.S_IFMT {
+	case syscall.S_IFDIR:
+	case syscall.S_IFLNK:
+		if opts.private {
+			return 0, nil // clean.sh never follows or counts a symlinked root
+		}
+		w.addFile(root.Dev, root.Ino, uint32(root.Nlink), root.Blocks*512)
+		return w.total.Load(), nil
+	default:
+		if opts.private {
+			if root.Mode&syscall.S_IFMT == syscall.S_IFREG {
+				w.addPrivateFile(root.Dev, root.Ino, uint32(root.Nlink), privateBytesOf(path, root.Blocks*512))
+				w.settlePrivateLinks()
+			}
+		} else {
+			w.addFile(root.Dev, root.Ino, uint32(root.Nlink), root.Blocks*512)
+		}
+		return w.total.Load(), nil
+	}
+
+	if !opts.private {
+		w.total.Add(root.Blocks * 512)
+	}
+	w.queue, w.pending = []string{path}, 1
+	w.cond = sync.NewCond(&w.mu)
+	workers := max(runtime.NumCPU()*2, 4)
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Go(w.work)
+	}
+	wg.Wait()
+	w.settlePrivateLinks()
+
+	size := w.total.Load()
+	if err := ctx.Err(); err != nil {
+		return size, fmt.Errorf("walk incomplete for %s: %w", path, err)
+	}
+	if w.firstErr != nil {
+		if w.allPerm {
+			return size, fmt.Errorf("walk incomplete for %s: %w: %w", path, w.firstErr, fs.ErrPermission)
+		}
+		return size, fmt.Errorf("walk incomplete for %s: %w", path, w.firstErr)
+	}
+	return size, nil
+}
+
+func (w *treeWalk) work() {
+	for {
+		w.mu.Lock()
+		for len(w.queue) == 0 && w.pending > 0 {
+			w.cond.Wait()
+		}
+		if w.pending == 0 {
+			w.mu.Unlock()
+			return
+		}
+		// LIFO keeps the queue short (depth-first) on wide trees
+		dir := w.queue[len(w.queue)-1]
+		w.queue = w.queue[:len(w.queue)-1]
+		w.mu.Unlock()
+
+		subdirs := w.read(dir)
+
+		w.mu.Lock()
+		w.queue = append(w.queue, subdirs...)
+		w.pending += len(subdirs) - 1
+		w.cond.Broadcast()
+		w.mu.Unlock()
+	}
+}
+
+// read sizes the entries of one directory and returns its subdirectories to walk.
+func (w *treeWalk) read(dir string) []string {
+	if w.ctx.Err() != nil {
+		return nil
+	}
+	f, err := os.Open(dir)
+	if err != nil {
+		w.fail(err)
+		return nil
+	}
+	defer f.Close()
+
+	var subdirs []string
+	err = readDirBulk(f, func(st *bulkStat) {
+		if w.opts.ignore[st.name] {
+			return
+		}
+		p := dir + "/" + st.name
+		if st.err != 0 {
+			w.fail(&os.PathError{Op: "getattrlistbulk", Path: p, Err: st.err})
+			return
+		}
+		if st.objType == vDir {
+			if st.mountPoint {
+				// bulk attributes describe the directory under the mount; ask the mounted root
+				if !w.opts.crossMounts || w.opts.private {
+					return // another file system (an iPhone's DeviceFS, a disk image…), like du -x
+				}
+				var mst syscall.Stat_t
+				if err := syscall.Lstat(p, &mst); err != nil {
+					w.fail(&os.PathError{Op: "lstat", Path: p, Err: err})
+					return
+				}
+				w.total.Add(mst.Blocks * 512)
+			} else if !w.opts.private {
+				w.total.Add(st.alloc)
+			}
+			subdirs = append(subdirs, p)
+			return
+		}
+		if w.opts.private {
+			if st.objType != vReg {
+				return
+			}
+			size := st.alloc
+			if st.privateKnown && st.flags&ufCompressed == 0 && st.private < size {
+				size = st.private
+			}
+			w.addPrivateFile(st.dev, st.ino, st.nlink, size)
+			return
+		}
+		w.addFile(st.dev, st.ino, st.nlink, st.alloc)
+	})
+	if err == nil {
+		return subdirs
+	}
+	if !errors.Is(err, errBulkUnsupported) {
+		w.fail(err)
+		return subdirs
+	}
+
+	names, err := f.Readdirnames(-1)
+	if err != nil {
+		w.fail(err)
+	}
+	for _, name := range names {
+		if w.opts.ignore[name] {
+			continue
+		}
+		p := dir + "/" + name
+		var st syscall.Stat_t
+		if err := syscall.Lstat(p, &st); err != nil {
+			w.fail(&os.PathError{Op: "lstat", Path: p, Err: err})
+			continue
+		}
+		switch {
+		case st.Mode&syscall.S_IFMT == syscall.S_IFDIR:
+			if st.Dev != w.dev && (!w.opts.crossMounts || w.opts.private) {
+				continue // another file system, like du -x
+			}
+			if !w.opts.private {
+				w.total.Add(st.Blocks * 512)
+			}
+			subdirs = append(subdirs, p)
+		case w.opts.private:
+			if st.Mode&syscall.S_IFMT == syscall.S_IFREG {
+				w.addPrivateFile(st.Dev, st.Ino, uint32(st.Nlink), privateBytesOf(p, st.Blocks*512))
+			}
+		default:
+			w.addFile(st.Dev, st.Ino, uint32(st.Nlink), st.Blocks*512)
+		}
+	}
+	return subdirs
+}
+
+func (w *treeWalk) addFile(dev int32, ino uint64, nlink uint32, alloc int64) {
+	if nlink > 1 {
+		if _, dup := w.links.LoadOrStore(walkInode{dev, ino}, struct{}{}); dup {
+			return
+		}
+	}
+	w.total.Add(alloc)
+}
+
+// addPrivateFile counts a file for the freed-bytes rule; a hard-linked one waits until
+// the walk shows whether every link is inside the tree.
+func (w *treeWalk) addPrivateFile(dev int32, ino uint64, nlink uint32, size int64) {
+	if nlink <= 1 {
+		w.total.Add(size)
+		return
+	}
+	w.privMu.Lock()
+	defer w.privMu.Unlock()
+	link := w.privLinks[walkInode{dev, ino}]
+	if link == nil {
+		link = &privateLink{nlink: nlink, size: size}
+		w.privLinks[walkInode{dev, ino}] = link
+	}
+	link.seen++
+}
+
+func (w *treeWalk) settlePrivateLinks() {
+	for _, link := range w.privLinks {
+		if link.seen == link.nlink {
+			w.total.Add(link.size)
+		}
+	}
+}
+
+// privateBytesOf is clean.sh's private_bytes for one path: the private size when the
+// volume reports one and the file is not compressed, never more than allocated.
+func privateBytesOf(path string, allocated int64) int64 {
+	p, err := unix.BytePtrFromString(path)
+	if err != nil {
+		return allocated
+	}
+	list := attrList{bitmapCount: unix.ATTR_BIT_MAP_COUNT, commonAttr: unix.ATTR_CMN_RETURNED_ATTRS | unix.ATTR_CMN_FLAGS, forkAttr: attrCmnextPrivateSize}
+	var buf [36]byte // length, returned attribute set, flags, private size
+	_, _, errno := unix.Syscall6(unix.SYS_GETATTRLIST, uintptr(unsafe.Pointer(p)), uintptr(unsafe.Pointer(&list)),
+		uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)), uintptr(unix.FSOPT_NOFOLLOW|unix.FSOPT_ATTR_CMN_EXTENDED), 0)
+	if errno != 0 || binary.LittleEndian.Uint32(buf[0:]) < uint32(len(buf)) {
+		return allocated
+	}
+	common, ext := binary.LittleEndian.Uint32(buf[4:]), binary.LittleEndian.Uint32(buf[20:])
+	flags, private := binary.LittleEndian.Uint32(buf[24:]), int64(binary.LittleEndian.Uint64(buf[28:]))
+	if common&unix.ATTR_CMN_FLAGS == 0 || ext&attrCmnextPrivateSize == 0 || flags&ufCompressed != 0 {
+		return allocated
+	}
+	return min(private, allocated)
+}
+
+func (w *treeWalk) fail(err error) {
+	if errors.Is(err, fs.ErrNotExist) && !w.opts.missingIsError {
+		return
+	}
+	w.errMu.Lock()
+	defer w.errMu.Unlock()
+	if w.firstErr == nil {
+		w.firstErr = err
+	}
+	if !isPermissionFailure(err) {
+		w.allPerm = false
+	}
+}
